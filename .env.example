APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=negocios_ciudad
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync

# Solo en el .env de PRODUCCIÓN (Hostinger): ruta absoluta a la carpeta
# `storage` de `public_html` (carpeta hermana de negocio_ciudad que sirve
# el dominio de verdad) -- sin esto, los archivos subidos en vivo (logo,
# fotos de producto, etc.) se guardan en negocio_ciudad/public/storage, que
# el dominio no sirve, y dan 404. Dejar vacío en local.
# Valor real en Hostinger (cuenta u374453216, confirmado 2026-09-10):
# PUBLIC_STORAGE_PATH=/home/u374453216/domains/negociosentuciudad.com/public_html/storage
PUBLIC_STORAGE_PATH=

# Fase 8, Bloque C: ruta absoluta a public_html/ (SIN el /storage final --
# es la misma ruta de PUBLIC_STORAGE_PATH pero un nivel arriba). La usa
# App\Services\AssetDeployer para copiar los assets sin FTP a mano.
# PUBLIC_HTML_PATH=/home/u374453216/domains/negociosentuciudad.com/public_html
PUBLIC_HTML_PATH=
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# Fase 8, Bloque B: storage de logos/fotos en S3-compatible (Cloudflare R2
# o Backblaze B2) en vez del disco local atado a public_html. Con
# PUBLIC_DISK_DRIVER=local (default) no cambia nada -- ver config/filesystems.php.
# Para activarlo: PUBLIC_DISK_DRIVER=s3 + estas variables + correr
# `php artisan storage:migrar-a-s3` primero para subir lo que ya existe.
PUBLIC_DISK_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# R2/B2: endpoint propio del proveedor (no es AWS real), ej. R2:
# https://<account_id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
# URL pública base para armar los links a los archivos (el bucket público,
# o tu propio dominio/CDN delante si lo configuraste).
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Fase 3: chat de alta de negocio. Key gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Marketplace con Mercado Pago Connect (plantilla "Tienda"). client_id/secret
# son de la Aplicación de LA PLATAFORMA (crear en developers.mercadopago.com),
# no de cada negocio -- cada negocio conecta su propia cuenta por OAuth.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COMISION_PORCENTAJE=0.5
